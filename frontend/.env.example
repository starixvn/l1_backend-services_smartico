# Smartico Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration
VITE_API_BASE_URL=http://localhost:5227/api
VITE_SIGNALR_HUB_URL=http://localhost:5227/hubs/progress

# Temporary User ID (until JWT authentication is implemented)
# TODO: Remove this once TASK-010 (JWT auth) is complete
VITE_USER_ID=demo-user

# Feature Flags
VITE_ENABLE_SIGNALR=true
VITE_ENABLE_MOCK_DATA=false

# Cache Configuration (milliseconds)
VITE_CACHE_TTL=30000

# Development
VITE_DEBUG=true
