{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "smartico_backoffice_dev"
  },
  "Demo": {
    "DefaultOperatorId": "000000000000000000000001"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "smartico-missions-api-dev",
    "Audience": "smartico-missions-frontend-dev",
    "SecretKey": "dev-secret-key-not-for-production-use-at-least-256-bits-long-development-only",
    "ExpirationMinutes": 120
  },
  "Smartico": {
    "ApiKey": "your-dev-smartico-api-key",
    "BrandKey": "your-dev-brand-key",
    "Environment": "development",
    "BaseUrl": "https://api-dev.smartico.ai"
  },
  "SmarticoBonusApi": {
    "ApiKey": "your-dev-smartico-bonus-api-key",
    "BaseUrl": "http://localhost:5000/bonus"
  },
  "Cache": {
    "DefaultTtlSeconds": 10,
    "MissionsTtlSeconds": 10,
    "BadgesTtlSeconds": 20
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200"
    ]
  }
}
