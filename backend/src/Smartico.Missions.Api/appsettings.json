{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "smartico-missions-api",
    "Audience": "smartico-missions-frontend",
    "SecretKey": "your-secret-key-at-least-256-bits-long-for-production-use-environment-variable",
    "ExpirationMinutes": 60
  },
  "Smartico": {
    "ApiKey": "your-smartico-api-key",
    "BrandKey": "your-brand-key",
    "Environment": "production",
    "BaseUrl": "https://api.smartico.ai"
  },
  "SmarticoBonusApi": {
    "ApiKey": "your-smartico-bonus-api-key",
    "BaseUrl": "https://api.smartico.ai/bonus"
  },
  "Cache": {
    "DefaultTtlSeconds": 30,
    "MissionsTtlSeconds": 30,
    "BadgesTtlSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
